# ExamLens environment configuration (placeholders only).
# Copy to a location OUTSIDE the repository, e.g. %USERPROFILE%\.examlens\examlens.env
# and point EXAMLENS_ENV_FILE at it, or set these as real OS environment variables.
# Never commit real secrets.

# --- Database (MySQL 8+) ---
DB_URL=jdbc:mysql://localhost:3306/examlens?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# --- AI provider ---
# gemini (live, Gemini) / groq (live, Groq OpenAI-compatible) / mock (explicitly labelled simulated provider, for offline demos/tests)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_api_key
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_INPUT_CHARS=60000
AI_RATE_LIMIT_PER_HOUR=30

# --- Uploads ---
# Store outside the deployed web application. Defaults to %USERPROFILE%\.examlens\uploads
EXAMLENS_STORAGE_DIR=
UPLOAD_MAX_MB=15
UPLOAD_MAX_PAGES=80

# --- Web ---
APP_BASE_URL=http://localhost:8080/examlens
APP_SECURE_COOKIES=false
SESSION_TIMEOUT_MINUTES=45

# --- Optional OCR ---
# Path to a Tesseract installation. If absent, scanned pages use Gemini vision when
# a live key is configured; otherwise they are honestly marked as unreadable.
TESSERACT_DATA_PATH=
TESSERACT_LANGUAGE=eng
