<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="pageTitle" value="Practice" />
<%@ include file="/WEB-INF/jsp/fragments/head.jspf" %>

<div class="page-head">
    <div class="page-head__text">
        <h1>Practice</h1>
        <p class="lede">Mock papers and focused question sets generated by the AI from your confirmed topics. Multiple-choice answers are graded on the server.</p>
    </div>
    <div class="page-head__actions"><a class="btn btn--primary" href="${ctx}/practice/new?examId=${exam.id}">New paper</a></div>
</div>

<div class="grid grid--3 section">
    <div class="card stat"><div class="stat__label">Papers</div><div class="stat__value">${paperCount}</div><div class="stat__sub">generated</div></div>
    <div class="card stat"><div class="stat__label">Attempts</div><div class="stat__value">${fn:length(attempts)}</div><div class="stat__sub">recent</div></div>
    <div class="card stat"><div class="stat__label">Average</div><div class="stat__value"><c:choose><c:when test="${empty practiceAverage}">—</c:when><c:otherwise>${practiceAverage}%</c:otherwise></c:choose></div><div class="stat__sub">across attempts</div></div>
</div>

<div class="split">
    <section class="section">
        <div class="section__head"><h2>Your papers</h2></div>
        <c:choose>
            <c:when test="${empty papers}">
                <div class="empty"><h3>No papers yet</h3><p class="muted">Generate a mock paper or a focused practice set.</p>
                    <a class="btn btn--primary" href="${ctx}/practice/new?examId=${exam.id}">Generate a paper</a></div>
            </c:when>
            <c:otherwise>
                <div class="stack">
                    <c:forEach var="paper" items="${papers}">
                        <a class="card card-link" href="${ctx}/practice/paper?id=${paper.id}">
                            <div class="row row--between">
                                <h3>${fn:escapeXml(paper.title)}</h3>
                                <span class="row">
                                    <span class="badge badge--muted">${paper.durationDisplay}</span>
                                    <c:if test="${paper.simulated}"><span class="badge badge--warn">simulated</span></c:if>
                                </span>
                            </div>
                            <div class="row small muted">
                                <span>${paper.totalMarks} marks</span>
                                <span>· ${fn:length(paper.questions)} question<c:if test="${fn:length(paper.questions) ne 1}">s</c:if></span>
                                <c:if test="${not empty paper.difficulty}"><span>· ${fn:toLowerCase(paper.difficulty)}</span></c:if>
                            </div>
                        </a>
                    </c:forEach>
                </div>
            </c:otherwise>
        </c:choose>
    </section>

    <section class="section">
        <div class="section__head"><h2>Recent attempts</h2></div>
        <c:choose>
            <c:when test="${empty attempts}">
                <div class="card"><p class="muted small">No attempts yet.</p></div>
            </c:when>
            <c:otherwise>
                <div class="card card--flush">
                    <table class="table">
                        <thead><tr><th>Paper</th><th>Score</th><th></th></tr></thead>
                        <tbody>
                            <c:forEach var="attempt" items="${attempts}">
                                <tr>
                                    <td>
                                        <c:choose>
                                            <c:when test="${empty attempt.paper}">Paper #${attempt.paperId}</c:when>
                                            <c:otherwise>${fn:escapeXml(attempt.paper.title)}</c:otherwise>
                                        </c:choose>
                                        <div class="small muted">${attempt.startedAt}</div></td>
                                    <td>${attempt.scoreDisplay}
                                        <c:if test="${attempt.submitted}"><div class="small muted">${attempt.scorePercent}%</div></c:if></td>
                                    <td class="num"><a class="btn btn--sm" href="${ctx}/practice/attempt?id=${attempt.id}">${attempt.submitted ? 'Results' : 'Resume'}</a></td>
                                </tr>
                            </c:forEach>
                        </tbody>
                    </table>
                </div>
            </c:otherwise>
        </c:choose>
    </section>
</div>

<%@ include file="/WEB-INF/jsp/fragments/foot.jspf" %>
