<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" trimDirectiveWhitespaces="true" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:if test="${not empty flash_success}">
    <div class="flash flash--success" role="status">
        <span aria-hidden="true">✓</span>
        <div class="flash__body"><c:out value="${flash_success}" /></div>
        <button type="button" class="flash__close" aria-label="Dismiss">&times;</button>
    </div>
</c:if>
<c:if test="${not empty flash_error}">
    <div class="flash flash--error" role="alert">
        <span aria-hidden="true">!</span>
        <div class="flash__body"><c:out value="${flash_error}" /></div>
        <button type="button" class="flash__close" aria-label="Dismiss">&times;</button>
    </div>
</c:if>
<c:if test="${not empty flash_info}">
    <div class="flash flash--info" role="status">
        <span aria-hidden="true">i</span>
        <div class="flash__body"><c:out value="${flash_info}" /></div>
        <button type="button" class="flash__close" aria-label="Dismiss">&times;</button>
    </div>
</c:if>
