<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" trimDirectiveWhitespaces="true" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header class="topbar">
    <button type="button" class="btn btn--ghost btn--icon menu-btn" data-drawer-open aria-label="Open navigation">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <h1 class="topbar__title"><c:choose><c:when test="${empty pageTitle}">ExamLens</c:when><c:otherwise>${pageTitle}</c:otherwise></c:choose></h1>
    <div class="topbar__spacer"></div>
    <div class="topbar__actions">
        <button type="button" class="btn btn--ghost btn--icon" data-theme-toggle data-current-theme="${theme}"
                title="Switch theme (system, light, dark)" aria-label="Switch theme">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a class="btn btn--ghost btn--icon" href="${ctx}/settings" title="Account settings" aria-label="Account settings">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
        </a>
        <span class="row" style="gap:.5rem;margin-left:.2rem;">
            <span class="avatar" aria-hidden="true">${currentUser.initials}</span>
            <span class="nowrap" style="font-size:.85rem;font-weight:600;">${currentUser.displayName}</span>
        </span>
        <form method="post" action="${ctx}/auth/logout" data-no-lock style="margin:0;">
            <input type="hidden" name="_csrf" value="${csrfToken}">
            <button type="submit" class="btn btn--ghost btn--sm">Sign out</button>
        </form>
    </div>
</header>
